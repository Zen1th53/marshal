{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marshal.local/schemas/protocol-negotiation.schema.json",
  "title": "MARSHAL Protocol Negotiation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "client_version",
    "server_version",
    "decision"
  ],
  "properties": {
    "protocol": {
      "enum": [
        "a2a",
        "mcp",
        "marshal-runtime"
      ]
    },
    "client_version": {
      "type": "string"
    },
    "server_version": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "compatible",
        "incompatible",
        "upgrade_required",
        "downgrade_required",
        "probe_required"
      ]
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
