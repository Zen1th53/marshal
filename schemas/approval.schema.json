{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/approval.schema.json",
  "title": "Agent OS Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "operation",
    "scope",
    "status",
    "requested_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^APR-[A-Za-z0-9._-]+$"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "requested",
        "approved",
        "denied",
        "expired",
        "consumed",
        "revoked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
